# Copy this file to .env and fill in your real values. Never commit the real .env file.

# Get this from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Which OpenAI model to use for extraction. Must support vision (image input) and
# JSON mode. OpenAI renames/replaces models fairly often -- if this model has been
# retired by the time you read this, check https://platform.openai.com/docs/models
# and swap in whatever their current cost-effective vision-capable model is called.
OPENAI_MODEL=gpt-4o-mini

# Get these from your Supabase project settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Name of the Supabase Storage bucket used for generated/uploaded files
SUPABASE_STORAGE_BUCKET=resumes

# Comma-separated list of staff names for the "who are you" picker (Phase 1 placeholder
# until real accounts exist). Edit this list to match your actual staff.
STAFF_NAMES=Santhoshi,Add Staff Member Here
